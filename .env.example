# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# -------------------------------------------------------------
# INSTITUTIONAL MPC CUSTODY & WALLET BROADCAST CONFIGURATION
# -------------------------------------------------------------
# CUSTODIAN_PROVIDER: 'FIREBLOCKS' | 'BITGO' | 'COINBASE_PRIME' | 'DIRECT_RPC_NODE' | 'SANDBOX_SIMULATOR'
CUSTODIAN_PROVIDER="SANDBOX_SIMULATOR"

# CUSTODIAN_MODE: 'SANDBOX_TESTNET' or 'PRODUCTION'
CUSTODIAN_MODE="SANDBOX_TESTNET"

# FIREBLOCKS API CREDENTIALS (if using Fireblocks MPC)
FIREBLOCKS_API_KEY=""
FIREBLOCKS_SECRET_KEY_PATH=""
FIREBLOCKS_VAULT_ID=""

# BITGO ENTERPRISE CREDENTIALS (if using BitGo Multisig/TSS)
BITGO_ACCESS_TOKEN=""
BITGO_ENTERPRISE_ID=""

# COINBASE PRIME INSTITUTIONAL API (if using Coinbase Prime)
COINBASE_PRIME_API_KEY=""
COINBASE_PRIME_PASSPHRASE=""
COINBASE_PRIME_PORTFOLIO_ID=""

# -------------------------------------------------------------
# LIVE MAINNET RPC ENDPOINTS (Funded Node Gateways)
# -------------------------------------------------------------
# Bitcoin Core bitcoind RPC (Mainnet)
MAINNET_RPC_BTC="https://bitcoin-mainnet.core.nexus-hash.internal:8332"

# Ethereum JSON-RPC (Alchemy, Infura, or Erigon/Geth archive node)
MAINNET_RPC_ETH="https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY"

# Solana Mainnet RPC
MAINNET_RPC_SOL="https://api.mainnet-beta.solana.com"

# -------------------------------------------------------------
# REGULATORY COMPLIANCE & AML SCREENING HOOKS
# -------------------------------------------------------------
# CHAINALYSIS_API_KEY (KYT - Know Your Transaction & Sanctions API)
CHAINALYSIS_API_KEY=""

# ELLIPTIC_API_KEY (AML / Sanctions Screening Alternative)
ELLIPTIC_API_KEY=""

# TRM_LABS_API_KEY (Wallet Risk Scoring Alternative)
TRM_LABS_API_KEY=""

# FATF TRAVEL RULE VASP IDENTIFIER
TRAVEL_RULE_VASP_DID="did:ethr:0x892a51a61c3905cf89e2193bfa0991c01994e772"
